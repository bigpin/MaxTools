/* pages/tools/jump-rope/history/index.wxss */
page {
    --primary-color: #00C853;
    --danger-color: #FF5252;
    --background: #F5F5F5;
    --text-primary: #212121;
    --text-secondary: #757575;
}

.container {
    min-height: 100vh;
    background-color: var(--background);
    padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部操作栏 */
.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx 30rpx;
    background-color: white;
    border-bottom: 1rpx solid #EEEEEE;
}

.record-count {
    font-size: 24rpx;
    color: var(--text-secondary);
}

.top-bar-right {
    display: flex;
    align-items: center;
}

.top-btn {
    font-size: 26rpx;
    padding: 8rpx 20rpx;
    border-radius: 20rpx;
    margin-left: 16rpx;
}

.edit-btn {
    color: var(--primary-color);
    background-color: rgba(0, 200, 83, 0.1);
}

.clear-btn {
    color: var(--danger-color);
    background-color: rgba(255, 82, 82, 0.1);
}

/* 批量删除操作栏 */
.batch-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16rpx 30rpx;
    background-color: #FFF3E0;
    border-bottom: 1rpx solid #FFE0B2;
}

.batch-info {
    font-size: 24rpx;
    color: #E65100;
}

.batch-delete-btn {
    font-size: 26rpx;
    color: white;
    background-color: var(--danger-color);
    padding: 10rpx 30rpx;
    border-radius: 20rpx;
}

/* 记录列表 */
.record-list {
    padding: 20rpx;
}

.record-card {
    background-color: white;
    border-radius: 15rpx;
    padding: 20rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.08);
    display: flex;
    align-items: center;
    transition: all 0.2s;
}

.record-card.selected {
    background-color: #E8F5E9;
    border: 2rpx solid var(--primary-color);
}

/* 选择框 */
.checkbox-area {
    padding: 10rpx 16rpx 10rpx 0;
}

.checkbox {
    width: 40rpx;
    height: 40rpx;
    border: 3rpx solid #BDBDBD;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    color: white;
    transition: all 0.2s;
}

.checkbox.checked {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

/* 记录内容 */
.record-content {
    flex: 1;
    min-width: 0;
}

.record-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15rpx;
    padding-bottom: 15rpx;
    border-bottom: 1rpx solid #EEEEEE;
}

.record-date {
    font-size: 28rpx;
    font-weight: bold;
    color: var(--text-primary);
}

.record-time {
    font-size: 24rpx;
    color: var(--text-secondary);
}

.record-body {
    display: flex;
    justify-content: space-around;
}

.record-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-value {
    font-size: 36rpx;
    font-weight: bold;
    color: var(--primary-color);
}

.stat-label {
    font-size: 20rpx;
    color: var(--text-secondary);
    margin-top: 5rpx;
}

/* 单条删除按钮 */
.delete-area {
    padding: 10rpx 0 10rpx 16rpx;
}

.delete-icon {
    font-size: 32rpx;
    opacity: 0.5;
}

.delete-area:active .delete-icon {
    opacity: 1;
}

/* 空状态 */
.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 120rpx 0;
}

.empty-icon {
    font-size: 80rpx;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 32rpx;
    color: var(--text-primary);
    margin-bottom: 10rpx;
}

.empty-hint {
    font-size: 24rpx;
    color: var(--text-secondary);
}
