page {
  background-color: #f5f7f8;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部与主页面一致：蓝色渐变 */
.status-bar {
  width: 100%;
  background: linear-gradient(135deg, #0052d9 0%, #366ef4 50%, #4a7cff 100%);
  flex-shrink: 0;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #0052d9 0%, #366ef4 50%, #4a7cff 100%);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
  pointer-events: none;
}

.header-left {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.back-btn {
  margin-right: 8rpx;
}

.back-btn:active {
  opacity: 0.6;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-left: 10rpx;
}

.search-wrap {
  padding: 0 24rpx 16rpx;
}

.stats-bar {
  padding: 0 24rpx 16rpx;
}

.stats-text {
  font-size: 24rpx;
  color: #7a9aa8;
}

.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e8f0f3;
  border-radius: 50%;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #1a3a47;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #7a9aa8;
}

.shortcut-list {
  flex: 1;
  padding: 0 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.shortcut-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s;
  box-sizing: border-box;
  width: 100%;
}

.shortcut-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.card-icon {
  width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e8f4f8;
  border-radius: 18rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.card-icon-img {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a3a47;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-desc {
  font-size: 24rpx;
  color: #7a9aa8;
  margin-bottom: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}

.card-meta {
  font-size: 22rpx;
  color: #b8c9d0;
}

.card-arrow {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.fab-help {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #1a5d6a 0%, #2d8a9a 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(26, 93, 106, 0.4);
  z-index: 100;
}

.fab-help:active {
  transform: scale(0.9);
}

/* 使用方式说明弹窗：整体左对齐排版 */
.usage-dialog-content {
  text-align: left;
}

.usage-dialog-body {
  text-align: left;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 32rpx;
  line-height: 1.6;
  color: rgba(0, 0, 0, 0.65);
}

