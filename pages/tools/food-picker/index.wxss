page {
  background-color: #FFF8F0;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== Header ===== */

.status-bar {
  width: 100%;
  background: linear-gradient(135deg, #FF9500 0%, #FF6B35 100%);
  flex-shrink: 0;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #FF9500 0%, #FF6B35 100%);
  position: relative;
}

.header::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  pointer-events: none;
}

.header-left {
  display: flex;
  align-items: center;
  z-index: 1;
}

.back-btn {
  margin-right: 8rpx;
}

.back-btn:active {
  opacity: 0.6;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-left: 6rpx;
}

/* ===== Period Badge ===== */

.period-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.period-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 149, 0, 0.15);
  position: relative;
}

.period-badge:active {
  opacity: 0.7;
}

.period-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.period-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #E65100;
}

.period-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pool-count {
  font-size: 24rpx;
  color: #BFA07A;
}

.settings-entry {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(255, 149, 0, 0.15);
  border: 2rpx solid #FFE0B2;
}

.settings-entry:active {
  transform: scale(0.9);
  opacity: 0.7;
}

/* ===== Period Picker ===== */

.period-picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.25);
  z-index: 500;
  opacity: 0;
  transition: opacity 0.2s ease;
  pointer-events: none;
}

.period-picker-mask-show {
  opacity: 1;
  pointer-events: auto;
}

.period-picker {
  position: absolute;
  top: 200rpx;
  left: 32rpx;
  width: 320rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

.period-picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  gap: 14rpx;
  border-bottom: 1rpx solid #F5EDE3;
}

.period-picker-item:last-child {
  border-bottom: none;
}

.period-picker-item:active {
  background: #FFF8F0;
}

.period-picker-active {
  background: #FFF3E0;
}

.period-picker-icon {
  font-size: 32rpx;
}

.period-picker-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #3E2723;
  flex: 1;
}

.period-picker-active .period-picker-label {
  color: #FF9500;
  font-weight: 600;
}

/* ===== Mode Switch ===== */

.mode-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx 32rpx 20rpx;
  background: #F5EDE3;
  border-radius: 16rpx;
  padding: 6rpx;
}

.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #9E8E7E;
  transition: all 0.25s ease;
}

.mode-tab-active {
  background: #fff;
  color: #FF9500;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* ===== Slot Machine ===== */

.slot-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
}

.slot-machine {
  position: relative;
  width: 100%;
  max-width: 620rpx;
}

.slot-frame {
  position: relative;
  display: flex;
  gap: 16rpx;
  background: linear-gradient(180deg, #FFF5E6 0%, #FFFFFF 40%, #FFFFFF 60%, #FFF5E6 100%);
  border-radius: 28rpx;
  padding: 20rpx 16rpx;
  box-shadow:
    0 8rpx 32rpx rgba(255, 149, 0, 0.12),
    inset 0 2rpx 8rpx rgba(255, 149, 0, 0.06);
  border: 3rpx solid #FFE0B2;
}

.slot-column {
  flex: 1;
  position: relative;
}

.slot-viewport {
  height: 400rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #FFFAF4;
  box-shadow: inset 0 0 0 2rpx #FFE8CC;
}

.slot-strip {
  will-change: transform;
}

.slot-highlight-wrap {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 20rpx;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 2;
}

.slot-item {
  height: 80rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.slot-food-text {
  display: block;
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #5D4037;
  line-height: 80rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  text-align: center;
}

.slot-highlight {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  border-top: 3rpx solid #FF9500;
  border-bottom: 3rpx solid #FF9500;
  background: rgba(255, 149, 0, 0.06);
  border-radius: 8rpx;
}

/* ===== Wheel ===== */

.wheel-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
}

.wheel-wrapper {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wheel-pointer {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
}

.wheel-pointer-arrow {
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 40rpx solid #FF6B35;
  filter: drop-shadow(0 4rpx 8rpx rgba(255, 107, 53, 0.4));
}

.wheel-rotate {
  width: 540rpx;
  height: 540rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow:
    0 0 0 8rpx #FFE0B2,
    0 0 0 14rpx rgba(255, 149, 0, 0.15),
    0 12rpx 40rpx rgba(255, 149, 0, 0.2);
}

.wheel-canvas {
  width: 540rpx;
  height: 540rpx;
}

.wheel-center-btn {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9500 0%, #FF6B35 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.4);
  border: 6rpx solid #fff;
}

.wheel-center-btn:active {
  transform: scale(0.9);
}

.wheel-center-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ===== Card Flip ===== */

.card-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  width: 100%;
  max-width: 620rpx;
}

.card-cell {
  aspect-ratio: 0.78;
  perspective: 800rpx;
}

.card-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.4, 0.0, 0.2, 1);
  border-radius: 20rpx;
}

.card-flipped .card-inner,
.card-inner.card-flipped {
  transform: rotateY(180deg);
}

.card-flipped {
  transform: rotateY(180deg);
}

.card-front,
.card-back {
  position: absolute;
  inset: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.card-front {
  background: linear-gradient(135deg, #FF9500 0%, #FFC107 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 149, 0, 0.25);
}

.card-front::after {
  content: '';
  position: absolute;
  inset: 8rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.4);
  border-radius: 14rpx;
  pointer-events: none;
}

.card-question {
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.card-back {
  background: #fff;
  border: 3rpx solid #FFE0B2;
  box-shadow: 0 6rpx 20rpx rgba(255, 149, 0, 0.15);
  transform: rotateY(180deg);
  flex-direction: column;
  padding: 16rpx;
}

.card-food-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #5D4037;
  text-align: center;
  word-break: break-all;
}

/* ===== Action Button ===== */

.action-area {
  padding: 24rpx 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.action-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #FF9500 0%, #FF6B35 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 24rpx rgba(255, 107, 53, 0.35),
    0 2rpx 8rpx rgba(255, 149, 0, 0.2);
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
}

.action-btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.action-btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.shake-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #C9A882;
}

/* ===== Result Popup ===== */

.result-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.result-mask-visible {
  opacity: 1;
  pointer-events: auto;
}

.result-card {
  width: 100%;
  max-width: 750rpx;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
  overflow: hidden;
}

.result-enter-active {
  transform: translateY(0);
}

.result-exit-active {
  transform: translateY(100%);
  transition: transform 0.3s ease-in;
}

.result-deco {
  position: absolute;
  top: -60rpx;
  right: -30rpx;
  opacity: 0.06;
  pointer-events: none;
}

.result-deco-circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: #FF9500;
}

.result-emoji {
  font-size: 100rpx;
  margin-bottom: 12rpx;
}

.result-category {
  font-size: 26rpx;
  color: #FF9500;
  font-weight: 600;
  background: #FFF3E0;
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.result-name {
  font-size: 56rpx;
  font-weight: 800;
  color: #3E2723;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.result-tip {
  font-size: 28rpx;
  color: #BFA07A;
  margin-bottom: 36rpx;
}

/* App Jump Icons */

.result-apps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 36rpx;
}

.app-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.app-btn:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.app-icon-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.meituan-bg {
  background: linear-gradient(135deg, #FFD600, #FFC107);
}

.dianping-bg {
  background: linear-gradient(135deg, #FF7043, #FF5722);
}

.app-icon-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}

.app-label {
  font-size: 22rpx;
  color: #9E8E7E;
}

/* Result Action Buttons */

.result-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FF9500 0%, #FF6B35 100%);
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.3);
}

.result-btn-primary:active {
  transform: scale(0.97);
}

.result-btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  background: transparent;
  border: 3rpx solid #FFE0B2;
  border-radius: 48rpx;
  color: #FF9500;
  font-size: 32rpx;
  font-weight: 600;
}

.result-btn-secondary:active {
  background: #FFF8F0;
  transform: scale(0.97);
}
